# ==============================================================================
# DaashTics Monorepo - Enterprise Environment Variables Template
# Salin file ini menjadi .env (untuk Docker Compose) dan backend/.env (untuk lokal)
# ==============================================================================

# --- DATABASE (PostgreSQL) ---
POSTGRES_DB=daashtics_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/daashtics_db

# --- ZERO-TRUST AUTHENTICATION & SECURITY ---
# Buat string acak 32-karakter: `openssl rand -hex 32`
SECRET_KEY=ganti_dengan_kunci_rahasia_acak_minimal_32_karakter_anda
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- DATA RETENTION ---
# Set "true" hanya jika ingin menghapus histori counting otomatis
ENABLE_AGGRESSIVE_CLEANUP=false

# --- EMERGENCY DISPATCH (WhatsApp / Fonnte) ---
WA_API_URL=https://api.fonnte.com/send
WA_API_TOKEN=

# --- EMAIL NOTIFICATIONS (SMTP) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_TLS=false
MAIL_USE_SSL=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
